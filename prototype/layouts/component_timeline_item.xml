<?xml version="1.0" encoding="utf-8"?>
<!--
    Timeline Item Component

    Reusable component for timeline view
    Supports states: completed, current, upcoming, future
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/spacing_sm">

    <!-- Timeline connector (left side) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginEnd="@dimen/spacing_md">

        <!-- Top connector line (hidden for first item) -->
        <View
            android:id="@+id/connectorTop"
            android:layout_width="@dimen/timeline_connector_width"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/divider" />

        <!-- Status dot -->
        <View
            android:id="@+id/statusDot"
            android:layout_width="@dimen/timeline_node_size"
            android:layout_height="@dimen/timeline_node_size"
            android:background="@drawable/timeline_dot_current" />

        <!-- Bottom connector line (hidden for last item) -->
        <View
            android:id="@+id/connectorBottom"
            android:layout_width="@dimen/timeline_connector_width"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/divider" />

    </LinearLayout>

    <!-- Event content card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEvent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="@dimen/card_corner_radius_small"
        app:cardElevation="@dimen/card_elevation"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/card_padding_compact">

            <!-- Header row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Event icon/emoji -->
                <TextView
                    android:id="@+id/tvIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    tools:text="🔬" />

                <!-- Event title -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:textAppearance="@style/TextAppearance.Mahina.TitleSmall"
                    android:textColor="@color/text_primary"
                    tools:text="USG 3 - Anomaly Scan" />

                <!-- Status badge -->
                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/spacing_sm"
                    android:paddingVertical="@dimen/spacing_xxs"
                    android:textAppearance="@style/TextAppearance.Mahina.StatusBadge"
                    android:textColor="@color/text_inverse"
                    android:background="@drawable/bg_badge_current"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="NOW" />

            </LinearLayout>

            <!-- Timing info -->
            <TextView
                android:id="@+id/tvTiming"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxs"
                android:textAppearance="@style/TextAppearance.Mahina.BodySmall"
                android:textColor="@color/text_secondary"
                tools:text="18-20 weeks" />

            <!-- Date range -->
            <TextView
                android:id="@+id/tvDateRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxs"
                android:textAppearance="@style/TextAppearance.Mahina.DateRange"
                tools:text="29 Apr - 13 May 2025" />

            <!-- Progress bar (for upcoming items) -->
            <ProgressBar
                android:id="@+id/progressWindow"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/progress_bar_height_thin"
                android:layout_marginTop="@dimen/spacing_sm"
                android:max="100"
                android:progressDrawable="@drawable/progress_event"
                android:visibility="gone"
                tools:visibility="visible"
                tools:progress="45" />

            <!-- Status text (e.g., "In 2 weeks", "Completed") -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="@style/TextAppearance.Mahina.LabelSmall"
                android:textColor="@color/text_secondary"
                tools:text="Window opens in 2 weeks" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
