<?xml version="1.0" encoding="utf-8"?>
<!--
    USG Item - Expandable

    Accordion-style item for USG schedule
    Shows summary when collapsed, full details when expanded
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- Left accent border via shape layer -->
    <View
        android:id="@+id/accentBorder"
        android:layout_width="@dimen/left_accent_width"
        android:layout_height="match_parent"
        android:background="@color/event_usg"
        android:layout_gravity="start" />

    <!-- Header (always visible) -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/card_padding"
        android:minHeight="56dp">

        <!-- Expand/Collapse indicator -->
        <ImageView
            android:id="@+id/ivExpandIndicator"
            android:layout_width="@dimen/icon_size_md"
            android:layout_height="@dimen/icon_size_md"
            android:src="@drawable/ic_chevron_down"
            app:tint="@color/text_tertiary"
            android:contentDescription="Expand"
            android:rotation="0" />

        <!-- Main content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_sm"
            android:orientation="vertical">

            <!-- Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Mahina.TitleSmall"
                android:textColor="@color/text_primary"
                tools:text="USG 1 - Dating Scan" />

            <!-- Timing (always visible) -->
            <TextView
                android:id="@+id/tvTiming"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxs"
                android:textAppearance="@style/TextAppearance.Mahina.BodySmall"
                android:textColor="@color/text_secondary"
                tools:text="6-8 weeks" />

        </LinearLayout>

        <!-- Status indicator -->
        <View
            android:id="@+id/statusIndicator"
            android:layout_width="@dimen/status_dot_size_small"
            android:layout_height="@dimen/status_dot_size_small"
            android:background="@drawable/timeline_dot_future"
            android:layout_marginStart="@dimen/spacing_sm" />

    </LinearLayout>

    <!-- Expandable content -->
    <LinearLayout
        android:id="@+id/expandableContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="@dimen/card_padding"
        android:paddingBottom="@dimen/card_padding"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Date Range -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="@dimen/icon_size_sm"
                android:layout_height="@dimen/icon_size_sm"
                android:src="@drawable/ic_calendar"
                app:tint="@color/text_tertiary"
                android:contentDescription="Date" />

            <TextView
                android:id="@+id/tvDateRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:textAppearance="@style/TextAppearance.Mahina.BodyMedium"
                android:textColor="@color/text_primary"
                tools:text="28 Jan - 11 Feb 2025" />

        </LinearLayout>

        <!-- Purpose/Description -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:textAppearance="@style/TextAppearance.Mahina.BodySmall"
            android:textColor="@color/text_secondary"
            android:lineSpacingMultiplier="1.4"
            tools:text="Confirms pregnancy, establishes accurate dates, and checks for multiple pregnancies." />

        <!-- Action buttons (for mother view) -->
        <LinearLayout
            android:id="@+id/actionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/spacing_md"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReminder"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height_small"
                android:text="Set Reminder"
                android:textAppearance="@style/TextAppearance.Mahina.LabelMedium"
                app:icon="@drawable/ic_notifications"
                app:iconSize="@dimen/icon_size_sm"
                app:cornerRadius="@dimen/button_corner_radius_small"
                app:strokeColor="@color/primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkComplete"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height_small"
                android:layout_marginStart="@dimen/spacing_sm"
                android:text="Mark Complete"
                android:textAppearance="@style/TextAppearance.Mahina.LabelMedium"
                app:icon="@drawable/ic_check"
                app:iconSize="@dimen/icon_size_sm"
                app:cornerRadius="@dimen/button_corner_radius_small" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
